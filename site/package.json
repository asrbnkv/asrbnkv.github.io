{
  "name": "artem-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint",
    "dev:ensure": "bash scripts/ensure-dev.sh",
    "dev:stop": "bash scripts/stop-dev.sh",
    "shoot": "bash scripts/shoot.sh",
    "verify": "npm run typecheck && npm run lint && npm run build && node scripts/check-export.mjs",
    "a11y": "node scripts/a11y.mjs",
    "preview": "npx --yes serve@14.2.4 out -l 4173"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "playwright": "1.64.1",
    "typescript": "5.9.3"
  }
}
